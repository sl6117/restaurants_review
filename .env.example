# Copy to .env and fill in. Node loads it via --env-file-if-exists=.env
# (see the scripts in package.json). Never commit .env.

# Google Places API (New) key. Used only by the scraper health check
# (src/sources/googlePlaces.ts) and `npm run resolve-place-id`.
# Create it in Google Cloud Console and restrict it to Places API (New).
GOOGLE_MAPS_API_KEY=

# Optional. Leave empty: the first real run creates the Google Doc itself and
# remembers its id in data/document.json. Only set this to force writes into a
# specific doc - and it must be a doc this app created, because the drive.file
# scope cannot open documents made by hand (see SETUP.md).
GOOGLE_DOC_ID=

# Optional path overrides for the OAuth material written by `npm run authorize`.
# Defaults (from src/config.ts): credentials/oauth-client.json and
# credentials/token.json. The credentials/ directory is gitignored.
GOOGLE_OAUTH_CLIENT=
GOOGLE_OAUTH_TOKEN=
